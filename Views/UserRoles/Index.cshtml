@{
    ViewData["Title"] = "User Roles";
}

<div class="container mt-4">
    <h2>User Roles</h2>

    <div id="rolesArea" class="mt-3">
        <div class="mb-3 d-flex gap-2">
            <input type="text" id="newRoleName" class="form-control w-auto" placeholder="New role name" />
            <button type="button" class="btn btn-primary" id="btnAddRole">Add role</button>
            <a asp-controller="RegisterUser" asp-action="RegisterUser" class="btn btn-secondary ms-2">Back to Register</a>
        </div>

        <div id="rolesList" class="card">
            <div class="card-body">
                <ul id="roleItems" class="list-group list-group-flush"></ul>
            </div>
        </div>

        <div id="rolesMessage" class="text-danger mt-2"></div>
    </div>
</div>

<script>
    function loadRolesToList() {
        fetch('/RegisterUser/GetRoles')
            .then(r => r.json())
            .then(list => {
                const ul = document.getElementById('roleItems');
                ul.innerHTML = '';
                list.forEach(r => {
                    const li = document.createElement('li');
                    li.className = 'list-group-item d-flex justify-content-between align-items-center';
                    li.textContent = r;
                    ul.appendChild(li);
                });
            })
            .catch(() => {
                document.getElementById('rolesMessage').textContent = 'Unable to load roles.';
            });
    }

    function addRoleFromPage() {
        const name = document.getElementById('newRoleName').value.trim();
        document.getElementById('rolesMessage').textContent = '';
        if (!name) {
            document.getElementById('rolesMessage').textContent = 'Enter a role name.';
            return;
        }
        fetch('/RegisterUser/AddRole', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name })
        })
        .then(async res => {
            if (res.ok) {
                document.getElementById('newRoleName').value = '';
                loadRolesToList();
                return;
            }
            const data = await res.json().catch(() => null);
            document.getElementById('rolesMessage').textContent = (data && data.error) ? data.error : 'Could not add role.';
        })
        .catch(() => document.getElementById('rolesMessage').textContent = 'Network error.');
    }

    document.getElementById('btnAddRole').addEventListener('click', addRoleFromPage);
    loadRolesToList();
</script>
